{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE"
  },
  "cron": [
    {
      "name": "closing-reports",
      "schedule": "55 * * * *",
      "command": "npm run cron-report-chiusure"
    }
  ]
}
